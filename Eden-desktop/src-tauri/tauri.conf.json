{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eden-desktop",
  "version": "0.1.0",
  "identifier": "com.suvan.eden",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eden",
        "width": 1340,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
